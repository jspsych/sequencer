{
  "name": "@jspsych/sequencer",
  "version": "0.1.0",
  "description": "Constrained random orders for experiment trials: run limits, gaps, counts, transition balance and custom rules",
  "type": "module",
  "main": "dist/index.cjs",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "typings": "dist/index.d.ts",
  "unpkg": "dist/index.browser.min.js",
  "files": [
    "src",
    "dist"
  ],
  "source": "src/index.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "npm test -- --watch",
    "tsc": "tsc",
    "build": "rollup --config",
    "build:watch": "npm run build -- --watch",
    "format": "prettier --write .",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install",
    "changeset:publish": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jspsych/sequencer.git"
  },
  "keywords": [
    "jspsych",
    "randomization",
    "pseudorandom",
    "counterbalancing",
    "trial order",
    "experiment"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jspsych/sequencer/issues"
  },
  "homepage": "https://github.com/jspsych/sequencer#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.4.7",
    "@changesets/cli": "^2.25.2",
    "@sucrase/jest-plugin": "3.0.0",
    "@types/jest": "29.5.8",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "jest": "29.7.0",
    "prettier": "^2.7.1",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "6.1.1",
    "rollup-plugin-esbuild": "6.2.1",
    "seedrandom": "^3.0.5",
    "sucrase": "3.34.0",
    "typescript": "^5.7.0"
  }
}
